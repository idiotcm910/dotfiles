#!/usr/bin/env bash
# tmux-grid — gộp mọi window của session hiện tại thành lưới pane trong một window;
# chạy lại để tách mỗi pane về đúng window cũ.
#
# Dùng: prefix g (bind trong tmux.conf). Truyền tên layout làm tham số để chạy
# không tương tác, bỏ qua popup — dành cho test.
set -euo pipefail

[ -n "${TMUX:-}" ] || { echo "tmux-grid: phải chạy bên trong tmux" >&2; exit 1; }

TAB=$'\t'

# Window đang active của session. run-shell không truyền target nên không dùng -t.
cur_win() { tmux display-message -p '#{window_id}'; }

LAYOUTS='tiled
even-horizontal
even-vertical
main-vertical
main-horizontal'

# Chọn layout. In ra stdout tên layout, hoặc chuỗi rỗng nếu người dùng thoát fzf.
pick_layout() {
  printf '%s\n' "$LAYOUTS" \
    | fzf-tmux -p 42%,40% --no-sort --prompt '  layout  ' --border-label " gộp $1 pane " \
    || true
}

# Hỏi xác nhận khi lưới sẽ quá chật. Trả về 0 nếu đồng ý.
confirm_many() {
  local pick
  pick="$(printf 'Huỷ\nGộp %s pane\n' "$1" | fzf-tmux -p 42%,30% --no-sort --prompt '  lưới sẽ chật  ' || true)"
  [ "$pick" = "Gộp $1 pane" ]
}

merge() {
  local dst="$1" layout="$2" total
  local rows=() r p wid wix wnm last

  # Thu thập TRƯỚC khi join: renumber-windows on làm window_index đổi ngay khi
  # một window bị hút rỗng, đọc sau sẽ ra số sai.
  mapfile -t rows < <(
    tmux list-panes -s -F "#{pane_id}${TAB}#{window_id}${TAB}#{window_index}${TAB}#{window_name}" \
      | awk -F'\t' -v d="$dst" '$2 != d'
  )
  if [ "${#rows[@]}" -eq 0 ]; then
    tmux display-message "tmux-grid: session chỉ có một window, không có gì để gộp"
    return 0
  fi

  if [ -z "$layout" ]; then
    total=$(( ${#rows[@]} + $(tmux list-panes -t "$dst" -F x | wc -l) ))
    if [ "$total" -gt 6 ] && ! confirm_many "$total"; then
      return 0
    fi
    layout="$(pick_layout "$total")"
    [ -n "$layout" ] || return 0
  fi

  # Đánh cờ TRƯỚC vòng join: nếu một lệnh giữa chừng hỏng, các pane đã bị hút vào
  # vẫn nằm trong một window mang cờ @grid, nên lần bấm sau vào nhánh tách và gỡ
  # lại được. Đặt cờ sau vòng join thì thất bại giữa chừng là kẹt vĩnh viễn.
  tmux set-option -w -t "$dst" @grid on
  tmux set-option -w -t "$dst" @grid_layout "$layout"
  # Index gốc của window đích — phải đọc TRƯỚC vòng join, vì renumber-windows
  # đánh số lại ngay khi window đầu tiên bị hút rỗng. split_back cần nó để biết
  # window nào thuộc phía trước, window nào thuộc phía sau window lưới.
  tmux set-option -w -t "$dst" @grid_dst_idx \
    "$(tmux display-message -p -t "$dst" '#{window_index}')"

  for r in "${rows[@]}"; do
    IFS="$TAB" read -r p wid wix wnm <<<"$r"
    tmux set-option -p -t "$p" @grid_win_id   "$wid"
    tmux set-option -p -t "$p" @grid_win_name "$wnm"
    tmux set-option -p -t "$p" @grid_win_idx  "$wix"
    # Join vào pane cuối cùng để pane xếp đúng thứ tự window gốc.
    last="$(tmux list-panes -t "$dst" -F '#{pane_id}' | tail -1)"
    tmux join-pane -d -s "$p" -t "$last"
  done

  tmux select-layout -t "$dst" "$layout"
}

split_back() {
  local dst="$1"
  local rows=() r p gid gix gnm dst_idx after
  declare -A newwin=()

  # Lưới gộp bằng bản cũ, hoặc gộp hỏng trước khi kịp ghi, thì không có index gốc.
  dst_idx="$(tmux display-message -p -t "$dst" '#{@grid_dst_idx}')"
  [ -n "$dst_idx" ] || dst_idx="$(tmux display-message -p -t "$dst" '#{window_index}')"
  after="$dst"   # window mới nhất đã chèn ở phía sau window lưới

  # Chỉ những pane có @grid_win_id mới là pane bị hút vào; pane do người dùng
  # tự split sau khi gộp không có cờ nên được giữ nguyên tại window hiện tại.
  mapfile -t rows < <(
    tmux list-panes -t "$dst" -F "#{pane_id}${TAB}#{@grid_win_id}${TAB}#{@grid_win_idx}${TAB}#{@grid_win_name}" \
      | awk -F'\t' '$2 != ""' \
      | sort -s -t"$TAB" -k3,3n
  )

  for r in "${rows[@]}"; do
    IFS="$TAB" read -r p gid gix gnm <<<"$r"
    if [ -z "${newwin[$gid]:-}" ]; then
      # break-pane không có -t thì tmux thêm window vào cuối, nên gộp từ window
      # thứ hai trở đi sẽ xoay thứ tự sau khi tách. Chèn đúng phía so với window
      # lưới để round-trip trả lại đúng thứ tự cũ: nhóm phía trước duyệt tăng dần
      # nên -b vào chính $dst là đủ; nhóm phía sau phải nối tiếp window vừa tạo,
      # nếu cứ -a vào $dst thì chúng đảo ngược lẫn nhau.
      if [ "${gix:-0}" -lt "$dst_idx" ]; then
        tmux break-pane -d -b -t "$dst" -s "$p" -n "$gnm"
        newwin[$gid]="$(tmux display-message -p -t "$p" '#{window_id}')"
      else
        tmux break-pane -d -a -t "$after" -s "$p" -n "$gnm"
        newwin[$gid]="$(tmux display-message -p -t "$p" '#{window_id}')"
        after="${newwin[$gid]}"
      fi
    else
      tmux join-pane -d -s "$p" -t "${newwin[$gid]}"
    fi
    tmux set-option -pu -t "$p" @grid_win_id
    tmux set-option -pu -t "$p" @grid_win_name
    tmux set-option -pu -t "$p" @grid_win_idx
  done

  tmux set-option -wu -t "$dst" @grid
  tmux set-option -wu -t "$dst" @grid_layout
  tmux set-option -wu -t "$dst" @grid_dst_idx
}

main() {
  local dst layout="${1:-}"
  dst="$(cur_win)"

  # Kiểm layout trước khi đụng vào window nào: gõ nhầm tên layout mà vẫn gộp rồi
  # mới chết ở select-layout là đúng đường dẫn tới trạng thái kẹt.
  if [ -n "$layout" ] && ! printf '%s\n' "$LAYOUTS" | grep -qxF -- "$layout"; then
    echo "tmux-grid: layout không hợp lệ: $layout" >&2
    exit 1
  fi

  # Nhận ra lưới kể cả khi cờ @grid mất (lần gộp trước chết giữa chừng): pane còn
  # mang @grid_win_id thì đây vẫn là lưới và phải tách lại được.
  if [ "$(tmux display-message -p -t "$dst" '#{@grid}')" = "on" ] \
     || [ -n "$(tmux list-panes -t "$dst" -F '#{@grid_win_id}' | tr -d '\n')" ]; then
    split_back "$dst"
  else
    merge "$dst" "$layout"
  fi
}

main "$@"
