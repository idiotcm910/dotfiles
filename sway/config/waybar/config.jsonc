{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["cpu", "memory", "network", "pulseaudio", "battery", "clock", "tray"],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },
  "sway/window": {
    "max-length": 70,
    "rewrite": { "(.*) — Mozilla Firefox": "󰈹  $1" }
  },
  "cpu": { "interval": 5, "format": "󰍛 {usage}%" },
  "memory": { "interval": 5, "format": "󰘚 {used:0.1f}G" },
  "network": {
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰖪  offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁹"]
  },
  "clock": { "format": "󰥔 {:%a, %d/%m · %H:%M}", "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>" },
  "tray": { "spacing": 10 }
}
