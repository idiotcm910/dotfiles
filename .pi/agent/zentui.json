{
  "components": {
    "footer": {
      "style": "starship",
      "colorSource": "theme",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "$model $fill $context $sep $tokens $sep $cost $sep $session_duration",
          "responsive": true,
          "compactFormat": "$model $wrap$context $wrap_sep$tokens $wrap_sep$cost $wrap_sep$session_duration",
          "compactMaxLines": 1,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "segments": {
            "cwd": false,
            "sessionName": false,
            "gitBranch": false,
            "gitStatus": false,
            "gitCounts": false,
            "runtime": false,
            "username": false,
            "os": false,
            "time": false,
            "modelInfo": true,
            "context": true,
            "tokens": true,
            "cost": true,
            "sessionDuration": true,
            "packageVersion": false,
            "gitCommit": false,
            "gitMetrics": false
          },
          "extensionStatuses": {
            "defaultPlacement": "off",
            "placements": {},
            "colorModes": {}
          }
        }
      }
    }
  },
  "colors": {
    "contextNormal": "bright-black",
    "contextWarning": "bold yellow",
    "contextError": "bold red",
    "sessionDuration": "yellow",
    "separator": "bright-black",
    "tokens": "bright-black",
    "cost": "bold green"
  }
}
