{
  "packages": [
    "npm:pi-codex",
    "npm:@howaboua/pi-codex-conversion",
    "npm:pi-alibaba-models",
    "npm:pi-zentui",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-rtk-optimizer",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-advisor",
    "git:github.com/obra/superpowers",
    "npm:@henryqw/pi-auto-compact"
  ],
  "theme": "atom-one-dark",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.5",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "xai/grok-4.5",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "alibaba-plan/deepseek-v4-flash-0731",
        "thinking": "medium"
      },
      "worker": {
        "model": "alibaba-plan/deepseek-v4-flash-0731",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "xai/grok-4.5",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "alibaba-plan/deepseek-v4-flash-0731",
        "thinking": "medium"
      },
      "delegate": {
        "model": "xai/grok-4.5",
        "thinking": "medium"
      }
    }
  },
  "compaction": {
    "enabled": false
  }
}
